#!/usr/bin/env python3
"""A fake `energibridge` for demonstrating GreenBench errors (not used by pytest).

Put this directory first on PATH to shadow the real binary in the current shell:

    export PATH="$PWD/tests/tools:$PATH"
    GB_FAKE_MODE=columns green-bench ...

GB_FAKE_MODE selects the behaviour:
    ok            valid telemetry (default)
    version-fails `energibridge --version` exits non-zero
    columns       CSV without any known power/energy column
    short         CSV with only one sample
    perm          measurement fails with a permission error
"""
import os
import subprocess
import sys

mode = os.environ.get("GB_FAKE_MODE", "ok")
args = sys.argv[1:]

if args[:1] == ["--version"]:
    if mode == "version-fails":
        sys.stderr.write("energibridge: cannot open MSR device\n")
        sys.exit(2)
    print("energibridge 0.0-fake")
    sys.exit(0)

if mode == "perm":
    sys.stderr.write("Error: Permission denied (os error 13). Try running with sudo.\n")
    sys.exit(1)

out, rest, i = None, [], 0
while i < len(args):
    if args[i] in ("-i", "--interval"):
        i += 2
    elif args[i] in ("-o", "--output"):
        out = args[i + 1]
        i += 2
    else:
        rest = args[i:]
        break

returncode = subprocess.run(" ".join(rest), shell=True).returncode

if out:
    with open(out, "w") as f:
        if mode == "columns":
            f.write("Time,FOO_METRIC\n0,1\n500,2\n1000,3\n")
        elif mode == "short":
            f.write("Time,SYSTEM_POWER (Watts)\n0,10\n")
        else:
            f.write("Delta,Time,SYSTEM_POWER (Watts)\n")
            for n in range(6):
                f.write(f"500,{1000 + n * 500},{10 + n % 2}\n")
sys.exit(returncode)
